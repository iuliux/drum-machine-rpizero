[Unit]
Description=Drum Machine Sequencer
After=basic.target
ConditionVirtualization=!container

[Service]
# Run as root (required for real-time scheduling on dedicated device)
User=root
WorkingDirectory=/home/pi/drum-machine-rpizero

# Start immediately - no network wait
ExecStart=/bin/bash /home/pi/drum-machine-rpizero/scripts/drummachine-start.sh

# Restart if it crashes
Restart=on-failure
RestartSec=10

# Increase default resource limits if needed for audio
LimitNOFILE=4096

# Use real-time FIFO scheduling via systemd (preferred over calling `chrt` from the script)
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
# Allow the real-time priority (matches CPUSchedulingPriority)
LimitRTPRIO=80

# Log output to journal (viewable with: journalctl -u drummachine -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drummachine

[Install]
WantedBy=multi-user.target
