[Unit]
Description=Drum Machine Sequencer
After=network.target sound.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/pi/drum-machine-rpizero
ExecStart=/home/pi/drum-machine-rpizero/scripts/drummachine-start.sh
Restart=on-failure
RestartSec=5

# Give it higher priority for audio
Nice=-10

[Install]
WantedBy=multi-user.target
