[Unit]
Description=Drum Machine Sequencer
# Wait for network target to be reached (but don't require active network)
After=network-online.target
Wants=network-online.target
# Make sure we wait for all startup jobs to finish
After=rc-local.service
# Only start if this is a real boot, not in containers
ConditionVirtualization=!container

[Service]
# Run as the pi user (adjust if your user is different)
User=pi
WorkingDirectory=/home/pi/drum-machine-rpizero

# Give the system 10 seconds to stabilize after network comes up
ExecStartPre=/bin/sleep 10

# Run the startup script
ExecStart=/bin/bash /home/pi/drum-machine-rpizero/scripts/drummachine-start.sh

# Restart if it crashes
Restart=on-failure
RestartSec=10

# Increase default resource limits if needed for audio
LimitNOFILE=4096

# Log output to journal (viewable with: journalctl -u drummachine -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drummachine

[Install]
# Start after multi-user target (normal system boot)
WantedBy=multi-user.target
